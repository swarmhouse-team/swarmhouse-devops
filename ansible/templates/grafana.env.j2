GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ lookup('ansible.builtin.password', local_vps_dir ~ '/passwords/grafana chars=ascii_letters,digits length=48') }}
GF_SERVER_ROOT_URL=http://127.0.0.1:{{ grafana_bind_port }}
GF_SERVER_PROTOCOL=http
GF_SECURITY_COOKIE_SECURE=false
GF_SECURITY_COOKIE_SAMESITE=lax
GF_SECURITY_DISABLE_BRUTE_FORCE_LOGIN_PROTECTION=false
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_ALLOW_ORG_CREATE=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_BASIC_ENABLED=true
JIRA_API_TOKEN={{ jira_api_token | replace('$', '$$') | to_json(ensure_ascii=false) }}
JIRA_USER={{ jira_user | replace('$', '$$') | to_json(ensure_ascii=false) }}
