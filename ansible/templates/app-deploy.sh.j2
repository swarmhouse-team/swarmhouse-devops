#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

[[ $# -eq 1 && ("$1" == rollback || "$1" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$) ]] || exit 2
exec /bin/bash /usr/local/sbin/swarmhouse-app-bootstrap {{ app_dir | quote }} {{ app_state_dir | quote }} "$1"
