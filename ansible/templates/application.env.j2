APP_HTTP_PORT={{ app_http_port }}
DATABASE_URL=postgresql://{{ app_postgres_user | urlencode | replace('/', '%2F') }}:{{ app_postgres_password | urlencode | replace('/', '%2F') }}@postgres:5432/{{ app_postgres_db | urlencode | replace('/', '%2F') }}
REDIS_URL=redis://:{{ app_redis_password | urlencode | replace('/', '%2F') }}@redis:6379
JWT_ACCESS_SECRET={{ lookup('ansible.builtin.password', local_vps_dir ~ '/passwords/application-jwt chars=ascii_letters,digits length=64') }}
WAREHOUSE_SOCKET_ORIGINS={{ app_socket_origins }}
