# ============================================================
# Docker bind-mount data
# ============================================================

# Shared layout: ./data/postgres, ./data/redis, ./data/grafana...
/data/

# Alternative layout: ./postgres/data, ./monitoring/data...
**/data/

# Legacy volume directories
**/postgres-data/
**/redis-data/
**/minio-data/
**/rabbitmq-data/
**/activemq-data/

